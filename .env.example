# Copy this file to .env for local development. The app reads .env on the server;
# this file is never packaged into the WAR. Replace all placeholders with the
# complete URI from Neon; reserved characters in credentials must be URL-encoded.
DB_URL=postgresql://<username>:<password>@<neon-endpoint>/<database>?sslmode=require
# DB_USER and DB_PASSWORD are only needed when DB_URL does not include credentials.
# DB_USER=
# DB_PASSWORD=
# Set to true when Tomcat is served over HTTPS. Use false for local HTTP.
SESSION_COOKIE_SECURE=false
# For one-time demo account setup, set DEMO_ACCOUNTS_ENABLED=true in Tomcat's
# protected process environment, start the app once, then remove the setting.
